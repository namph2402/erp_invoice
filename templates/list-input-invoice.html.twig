<div class="list-invoice d-flex flex-column h-100 min-w-0">
	<div class="p-2 header-wrapper">
		<div class="d-flex justify-content-between mb-3">
			<form method="GET" class="d-flex">
				<div class="d-flex">
					<input type="date" id="start-date" name="start_date" class="search-data form-control w-auto me-1" value="{{ filter.date.start }}"/>
					<input type="date" id="end-date" name="end_date" class="search-data form-control w-auto me-1" value="{{ filter.date.end }}"/>
				</div>
				<select name="company_id" class="form-control">
					<option value="">{{ "Select Company"|t }}</option>
					{% for company_id, company_name in filter.option_company %}
						<option value="{{ company_id }}" {% if filter.company_id == company_id %} selected {% endif %}>{{ company_name }}</option>
					{% endfor %}
				</select>
				<button type="submit" class="btn btn-primary ms-1" style="white-space: nowrap;">
					<i class="bi bi-search me-1"></i>
				</button>
			</form>
			<div class="d-flex align-items-start">
				<button data-search-date="last_week" class="btn btn-primary btn-search-date ms-1 text-nowrap">{{ "Last Week"|t }}</button>
				<button data-search-date="last_month" class="btn btn-primary btn-search-date ms-1 text-nowrap">{{ "Last Month"|t }}</button>
				<button data-search-date="full_date" class="btn btn-primary btn-search-date ms-1 text-nowrap">{{ "Full date"|t }}</button>
			</div>
		</div>
		<div>
			<button class="btn btn-warning ms-1 text-nowrap" data-bs-toggle="modal" data-bs-target="#modifiedInvoiceModal">{{ "Modified invoice"|t }}</button>
			<button class="btn btn-success ms-1 text-nowrap btn-import">{{ "Import invoice"|t }}
				{% if filter.count_import > 0 %}
					<span class="d-inline-flex px-2 border rounded-pill fw-bold">{{ filter.count_import }}</span>
				{% endif %}
			</button>
		</div>
	</div>
	<div class="flex-grow-1 min-h-0 min-w-0 p-2 bg-white">
		<div class="d-flex flex-column h-100 text-center">
			<h4 class="text-uppercase fw-bold my-2" id="title-report">
				{{ "List of input invoices"|t }}
			</h4>
			<div class="invoice-summary row g-2 mb-2 text-start">
				<div class="col-6 col-xl-3">
					<div class="summary-card h-100">
						<div class="summary-label">{{ "Number of invoices"|t }}</div>
						<div class="summary-value">{{ filter.summary.count|number_format(0, ",", ".") }}</div>
					</div>
				</div>
				<div class="col-6 col-xl-3">
					<div class="summary-card h-100">
						<div class="summary-label">{{ "Amount without vat"|t }}</div>
						<div class="summary-value">{{ filter.summary.amount_without_vat|number_format(0, ",", ".") }}</div>
					</div>
				</div>
				<div class="col-6 col-xl-3">
					<div class="summary-card h-100">
						<div class="summary-label">{{ "Vat amount"|t }}</div>
						<div class="summary-value">{{ filter.summary.vat_amount|number_format(0, ",", ".") }}</div>
					</div>
				</div>
				<div class="col-6 col-xl-3">
					<div class="summary-card summary-card-total h-100">
						<div class="summary-label">{{ "Total amount"|t }}</div>
						<div class="summary-value">{{ filter.summary.total_amount|number_format(0, ",", ".") }}</div>
					</div>
				</div>
			</div>
			<div class="invoice-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
				<div class="d-flex align-items-center gap-2">
					<select id="invoice-page-size-in" class="form-select form-select-sm invoice-page-size">
						{% for page_size in filter.option_page_size %}
							<option value="{{ page_size }}" {% if filter.page_size == page_size %} selected {% endif %}>{{ page_size }}</option>
						{% endfor %}
						<option value="0">{{ "All"|t }}</option>
					</select>
					<span class="small text-muted text-nowrap invoice-range"></span>
				</div>
				<div class="d-flex align-items-center gap-2">
					<div class="dropdown">
						<button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle text-nowrap" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
							<i class="bi bi-layout-three-columns me-1"></i>{{ "Columns"|t }}
						</button>
						<ul class="dropdown-menu dropdown-menu-end invoice-column-menu p-2"></ul>
					</div>
					<button type="button" class="btn btn-success btn-sm text-nowrap btn-export-excel">
						<i class="bi bi-file-earmark-excel me-1"></i>{{ "Export Excel"|t }}
					</button>
				</div>
			</div>

			<div class="flex-grow-1 min-h-0 min-w-0 invoice-table-wrapper">
				<table class="table table-hover table-bordered table-striped invoice-table"
					data-table-key="input-invoice" data-export-name="{{ "List of input invoices"|t }}">
					<thead class="text-center">
						<tr>
							<th class="text-nowrap" data-col-lock="1" data-col-sort="0" data-col-index="1">{{ 'Stt'|t }}</th>
							<th class="text-nowrap" data-col-export="0" data-col-sort="0">{{ 'File'|t }}</th>
							<th class="text-nowrap">{{ 'Invoice no'|t }}</th>
							<th class="text-nowrap">{{ 'Invoice date'|t }}</th>
							<th class="text-nowrap">{{ 'Tax authority code'|t }}</th>
							<th class="text-nowrap">{{ 'Check result'|t }}</th>
							<th class="text-nowrap">{{ 'Seller name'|t }}</th>
							<th class="text-nowrap">{{ 'Seller address'|t }}</th>
							<th class="text-nowrap">{{ 'Seller taxcode'|t }}</th>
							<th class="text-nowrap">{{ 'Pattern'|t }}</th>
							<th class="text-nowrap">{{ 'Serial'|t }}</th>
							<th class="text-nowrap">{{ 'Amount without vat'|t }}</th>
							<th class="text-nowrap">{{ 'Vat amount'|t }}</th>
							<th class="text-nowrap">{{ 'Total amount'|t }}</th>
							<th class="text-nowrap">{{ 'Invoice status'|t }}</th>
							<th class="text-nowrap">{{ 'Related invoices'|t }}</th>
							<th class="text-nowrap">{{ 'Payment due date'|t }}</th>
							<th class="text-nowrap">{{ 'Payment status'|t }}</th>
							<th class="text-nowrap">{{ 'Unpaid amount'|t }}</th>
							<th class="text-nowrap">{{ 'Buyer name'|t }}</th>
							<th class="text-nowrap">{{ 'Buyer address'|t }}</th>
							<th class="text-nowrap">{{ 'Buyer taxcode'|t }}</th>
							<th class="text-nowrap">{{ 'Accountant refno'|t }}</th>
							<th class="text-nowrap">{{ 'Accountant name'|t }}</th>
							<th class="text-nowrap">{{ 'Accounting date'|t }}</th>
							<th class="text-nowrap">{{ 'License plate'|t }}</th>
							<th class="text-nowrap" data-col-lock="1" data-col-export="0" data-col-sort="0">{{ "Action"|t }}</th>
						</tr>
					</thead>
					<tbody>
						{% for item in data %}
							<tr>
								<td class="text-center" data-value="{{ loop.index }}">{{ loop.index }}</td>
								<td class="text-center">
									{% if item.invoice_pdf is not empty %}
										<a href="{{ item.invoice_pdf }}" target="_blank">
											<i class="bi bi-filetype-pdf fs-5"></i>
										</a>
									{% endif %}
								</td>
								<td class="text-center">
									<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}" class="d-inline-block m-0 text-success text-decoration-none fw-medium use-ajax" data-dialog-type="modal" data-dialog-options='{"width":"70%","title":""}'>
										{{ item.invoice_no }}
									</a>
								</td>
								<td class="text-center">
									{{ item.invoice_date| date("d/m/Y") }}
								</td>
								<td class="text-center">
									{{ item.invoice_mccqt }}
								</td>
								<td class="text-center">
									{{ item.invoice_status_custorm}}
								</td>
								<td>
									{{ item.invoice_seller_name }}
								</td>
								<td>
									{{ item.invoice_seller_address }}
								</td>
								<td>
									{{ item.invoice_seller_taxcode }}
								</td>
								<td>
									{{ item.invoice_pattern }}
								</td>
								<td>
									{{ item.invoice_serial }}
								</td>
								<td class="text-end" data-value="{{ item.invoice_amount_without_vat }}">
									{{ item.invoice_amount_without_vat|number_format(0, ",", ".") }}
								</td>
								<td class="text-end" data-value="{{ item.invoice_vat_amount }}">
									{{ item.invoice_vat_amount|number_format(0, ",", ".") }}
								</td>
								<td class="text-end" data-value="{{ item.invoice_total_amount }}">
									{{ item.invoice_total_amount|number_format(0, ",", ".") }}
								</td>
								<td>
									{{ item.invoice_status }}
								</td>
								<td></td>
								<td>
									{{ item.invoice_payment_due_date| date("d/m/Y") }}
								</td>
								<td>
									{{ item.invoice_payment_status }}
								</td>
								<td>
									{{ item.invoice_total_amount_not_payment|number_format(0, ",", ".") }}
								</td>
								<td>
									{{ item.invoice_buyer_name }}
								</td>
								<td>
									{{ item.invoice_buyer_address }}
								</td>
								<td>
									{{ item.invoice_buyer_taxcode }}
								</td>
								<td class="text-center">
									{% if item.invoice_refno is not empty %}
										<p class="mb-0">{{ item.invoice_refno }}</p>
									{% endif %}
								</td>
								<td class="text-center">
									{% if item.invoice_accountant is not empty %}
										<p class="mb-0">{{ item.invoice_accountant }}</p>
									{% endif %}
								</td>
								<td class="text-center">
									{% if item.invoice_accountant_date is not empty %}
										<small>{{ item.invoice_accountant_date| date("d/m/Y") }}</small>
									{% endif %}
								</td>
								<td>
									{{ item.invoice_license_plate }}
								</td>
								<td>
									<div class="dropdown">
										<button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
											<i class="bi bi-list"></i>
										</button>
										<ul class="dropdown-menu">
											{% if item.invoice_import != 1 %}
												<li>
													<a href="{{ path('<front>') }}accountant/invoice/{{ item.uuid }}?destination={{ filter.destination }}" class="dropdown-item use-ajax" data-dialog-type="modal" data-dialog-options='{"width":"70%","title":""}'>
														{{ "Import"|t }}
													</a>
												</li>
											{% endif %}
											<li>
												{% if item.invoice_pdf is not empty %}
													<a class="dropdown-item" href="{{ item.invoice_pdf }}" target="_blank">
														{{ "View PDF"|t }}
													</a>
												{% else %}
													<a class="dropdown-item" href="{{ path("erp_e_invoice.e_invoice_file_invoice", {"type": "pdf", "uuid": item.uuid}, {"query" : {"destination" : filter.destination}}) }}">
														{{ "Download PDF"|t }}
													</a>
												{% endif %}
											</li>
											<li>
												{% if item.invoice_xml is not empty %}
													<a class="dropdown-item" href="{{ item.invoice_xml }}" target="_blank">
														{{ "View XML"|t }}
													</a>
												{% else %}
													<a class="dropdown-item" href="{{ path("erp_e_invoice.e_invoice_file_invoice", {"type": "xml", "uuid": item.uuid}, {"query" : {"destination" : filter.destination}}) }}">
														{{ "Download XML"|t }}
													</a>
												{% endif %}
											</li>
											<li>
												{% if item.invoice_pdf is empty and  item.invoice_xml is empty %}
													<a class="dropdown-item" href="{{ path("erp_e_invoice.e_invoice_file_invoice", {"type": "all", "uuid": item.uuid}, {"query" : {"destination" : filter.destination}}) }}">
														{{ "Download PDF & XML"|t }}
													</a>
												{% endif %}
											</li>
											<li>
												<a type="button" class="btn-payment-invoice dropdown-item"
													data-bs-toggle="modal" data-bs-target="#paymentInvoiceModal"
													data-invoice-uuid="{{ item.uuid }}"
													data-payment-due-date="{{ item.invoice_payment_due_date }}"
													data-payment-amount="{{ item.invoice_total_amount_payment }}"
													data-payment-amount-not="{{ item.invoice_total_amount_not_payment }}"
													data-payment-status="{{ item.invoice_payment_status_value }}">
													{{ "Update payment invoice"|t }}
												</a>
											</li>
											<li>
												{% if item.invoice_accountant is empty %}
													<a type="button" class="btn-uuid-invoice dropdown-item" data-bs-toggle="modal" data-bs-target="#uuidInvoiceModal" data-invoice-uuid="{{ item.uuid }}">
														{{ "Invoice accountant"|t }}
													</a>
												{% else %}
													<a class="dropdown-item" href="{{ path("erp_e_invoice.e_invoice_cancel_accoutant", {"uuid": item.uuid}, {"query" : {"destination" : filter.destination}}) }}">
														{{ "Cancel Accountant Invoice"|t }}
													</a>
												{% endif %}
											</li>
										</ul>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{# Phân trang chạy trên trình duyệt, danh sách dòng đã có sẵn trong bảng. #}
			<nav class="invoice-pagination d-flex justify-content-center mt-2" aria-label="{{ "Pagination"|t }}">
				<ul class="pagination pagination-sm mb-0 invoice-pages"></ul>
			</nav>
		</div>
	</div>
</div>

<!-- Modal -->
{{ include('@erp_e_invoice/templates/modal/modal-modified.html.twig') }}
{{ include('@erp_e_invoice/templates/modal/modal-accountant.html.twig') }}
{{ include('@erp_e_invoice/templates/modal/modal-payment.html.twig') }}
