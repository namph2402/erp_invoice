<div class="list-invoice d-flex flex-column h-100 min-w-0">
	<div class="flex-grow-1 min-h-0 min-w-0 p-2 bg-white">
		<div class="d-flex flex-column h-100 text-center">
			<h4 class="text-uppercase fw-bold my-2" id="title-report">
				{{ "List of warehouse invoices"|t }}
			</h4>
			<div class="invoice-toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
				<select id="invoice-page-size-warehouse" class="form-select form-select-sm invoice-page-size">
					{% for page_size in filter.option_page_size %}
						<option value="{{ page_size }}" {% if filter.page_size == page_size %} selected {% endif %}>{{ page_size }}</option>
					{% endfor %}
					<option value="0">{{ "All"|t }}</option>
				</select>
				<span class="small text-muted text-nowrap invoice-range"></span>
			</div>

			<div class="flex-grow-1 min-h-0 min-w-0 invoice-table-wrapper">
				<table class="table table-hover table-bordered table-striped invoice-table" data-table-key="warehouse-supplies">
					<thead class="text-center">
						<tr>
							<th class="text-nowrap" data-col-sort="0" data-col-index="1">{{ "Nº"|t }}</th>
							<th class="w-25">{{ "Title"|t }}</th>
							<th>{{ "Code"|t }}</th>
							<th>{{ "Quantity"|t }}</th>
							<th>{{ "Unit"|t }}</th>
							<th>{{ "Tax"|t }}</th>
							<th class="text-nowrap" data-col-sort="0">{{ "List import"|t }}</th>
							<th class="text-nowrap" data-col-sort="0">{{ "List export"|t }}</th>
						</tr>
					</thead>
					<tbody>
						{% for item in data %}
							<tr>
								<td class="text-center" data-value="{{ loop.index }}">{{ loop.index }}</td>
								<td class="text-start">
									<a class="list-unstyled" href="{{ path('<front>') }}node-uuid/{{ item.uuid }}" target="_blank">{{ item.name }}</a>
								</td>
								<td class="text-center">{{ item.code }}</td>
								<td class="text-end" data-value="{{ item.quantity }}">{{ item.quantity|number_format(0, ",", ".") }}</td>
								<td class="text-center">{{ item.unit }}</td>
								<td class="text-center">{{ item.tax }}</td>
								<td>
									<a href="{{ path('<front>') }}accountant/e-invoice-detail-import/{{ item.id }}" class="dropdown-item btn use-ajax"
										data-dialog-type="modal" data-dialog-options="{&quot;width&quot;:&quot;70%&quot;,&quot;title&quot;:&quot;&quot;}">
										{{ "View"|t }}
									</a>
								</td>
								<td>
									<a href="{{ path('<front>') }}accountant/e-invoice-detail-export/{{ item.id }}" class="dropdown-item btn use-ajax"
										data-dialog-type="modal" data-dialog-options="{&quot;width&quot;:&quot;70%&quot;,&quot;title&quot;:&quot;&quot;}">
										{{ "View"|t }}
									</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{# Phân trang chạy trên trình duyệt, danh sách dòng đã có sẵn trong bảng. #}
			<nav class="invoice-pagination d-flex justify-content-center mt-2" aria-label="{{ "Pagination"|t }}">
				<ul class="pagination pagination-sm mb-0 invoice-pages"></ul>
			</nav>
		</div>
	</div>
</div>
