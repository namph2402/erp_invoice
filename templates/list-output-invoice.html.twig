<div class="list-invoice d-flex flex-column h-100 min-w-0">
	<div class="p-2 header-wrapper">
		<div class="d-flex justify-content-between mb-3">
			<form method="GET" class="d-flex">
				<div class="d-flex">
					<input type="date" id="start-date" name="start_date" class="search-data form-control w-auto me-1" value="{{ filter.date.start }}"/>
					<input type="date" id="end-date" name="end_date" class="search-data form-control w-auto me-1" value="{{ filter.date.end }}"/>
				</div>
				<input name="buy_name" class="search-data form-control w-auto me-1" placeholder="{{ "Buyer name"|t }}" value="{{ filter.buy_name }}"/>
				<select name="status" class="form-control me-1" style="width: 150px">
					<option value="">{{ "Select status"|t }}</option>
					{% for status_id, status_name in filter.option_status %}
						<option value="{{ status_id }}" {% if filter.status == status_id %} selected {% endif %}>{{ status_name }}</option>
					{% endfor %}
				</select>
				<select name="company_id" class="form-control">
					<option value="">{{ "Select Company"|t }}</option>
					{% for company_id, company_name in filter.option_company %}
						<option value="{{ company_id }}" {% if filter.company_id == company_id %} selected {% endif %}>{{ company_name }}</option>
					{% endfor %}
				</select>
				<button type="submit" class="btn btn-primary ms-1" style="white-space: nowrap;">
					<i class="bi bi-search me-1"></i>
				</button>
			</form>
			<div class="d-flex align-items-start">
				<button data-search-date="last_week" class="btn btn-primary btn-search-date ms-1 text-nowrap">{{ "Last Week"|t }}</button>
				<button data-search-date="last_month" class="btn btn-primary btn-search-date ms-1 text-nowrap">{{ "Last Month"|t }}</button>
				<button data-search-date="full_date" class="btn btn-primary btn-search-date ms-1 text-nowrap">{{ "Full date"|t }}</button>
			</div>
		</div>
		<div>
			<a class="btn btn-warning ms-1 text-nowrap" href="{{ path('<front>') }}invoice/add/output_invoices?destination={{ path('<front>') }}accountant/e-invoice-out">{{ "Add invoice"|t }}</a>
			<a type="button" class="btn btn-info ms-1 text-nowrap" data-bs-toggle="modal" data-bs-target="#importInvoiceModal">
				{{ "Import XML"|t }}
			</a>
			{# <a type="button" class="btn-issue-multiple btn btn-success ms-1 text-nowrap" data-bs-toggle="modal" data-bs-target="#configInvoiceModal"
				data-company-id="{{ filter.company_id }}" data-routing="{{ path("erp_e_invoice.e_invoice_issue") }}">
				{{ "Issue multiple invoices"|t }}
			</a> #}
			<button class="btn btn-secondary ms-1 text-nowrap btn-export">{{ "Export invoice"|t }}
				{% if filter.count_export > 0 %}
					<span class="d-inline-flex px-2 border rounded-pill fw-bold">{{ filter.count_export }}</span>
				{% endif %}
			</button>
		</div>
	</div>
	<div class="flex-grow-1 min-h-0 min-w-0 p-2 bg-white">
		<div class="d-flex flex-column h-100 text-center">
			<h4 class="text-uppercase fw-bold my-2" id="title-report">
				{{ "List of output invoices"|t }}
			</h4>
			<div class="invoice-summary row g-2 mb-2 text-start">
				<div class="col-6 col-xl-3">
					<div class="summary-card h-100">
						<div class="summary-label">{{ "Number of invoices"|t }}</div>
						<div class="summary-value">{{ filter.summary.count|number_format(0, ",", ".") }}</div>
					</div>
				</div>
				<div class="col-6 col-xl-3">
					<div class="summary-card h-100">
						<div class="summary-label">{{ "Amount without vat"|t }}</div>
						<div class="summary-value">{{ filter.summary.amount_without_vat|number_format(0, ",", ".") }}</div>
					</div>
				</div>
				<div class="col-6 col-xl-3">
					<div class="summary-card h-100">
						<div class="summary-label">{{ "Vat amount"|t }}</div>
						<div class="summary-value">{{ filter.summary.vat_amount|number_format(0, ",", ".") }}</div>
					</div>
				</div>
				<div class="col-6 col-xl-3">
					<div class="summary-card summary-card-total h-100">
						<div class="summary-label">{{ "Total amount"|t }}</div>
						<div class="summary-value">{{ filter.summary.total_amount|number_format(0, ",", ".") }}</div>
					</div>
				</div>
			</div>

			<div class="invoice-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
				<div class="d-flex align-items-center gap-2">
					<select id="invoice-page-size-out" class="form-select form-select-sm invoice-page-size">
						{% for page_size in filter.option_page_size %}
							<option value="{{ page_size }}" {% if filter.page_size == page_size %} selected {% endif %}>{{ page_size }}</option>
						{% endfor %}
						<option value="0">{{ "All"|t }}</option>
					</select>
					<span class="small text-muted text-nowrap invoice-range"></span>
				</div>
				<div class="d-flex align-items-center gap-2">
					<span class="small text-muted text-nowrap invoice-selected-label">
						<span class="fw-bold invoice-selected-count">0</span>
						{{ "invoices selected"|t }}
					</span>
					<button type="button" class="btn btn-outline-warning btn-sm text-nowrap btn-items-multiple" disabled>
						<i class="bi bi-box-arrow-up me-1"></i>{{ "Export selected invoices"|t }}
					</button>
					<div class="dropdown">
						<button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle text-nowrap" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
							<i class="bi bi-layout-three-columns me-1"></i>{{ "Columns"|t }}
						</button>
						<ul class="dropdown-menu dropdown-menu-end invoice-column-menu p-2"></ul>
					</div>
					<button type="button" class="btn btn-success btn-sm text-nowrap btn-export-excel">
						<i class="bi bi-file-earmark-excel me-1"></i>{{ "Export Excel"|t }}
					</button>
				</div>
			</div>

			<form method="POST" class="form-items-multiple d-none" action="{{ path("erp_e_invoice.e_invoice_update_items_multiple") }}">
				<input type="hidden" name="uuids" class="input-items-uuid"/>
				<input type="hidden" name="destination" value="{{ filter.destination }}"/>
			</form>

			<div class="flex-grow-1 min-h-0 min-w-0 invoice-table-wrapper">
				<table class="table table-hover table-bordered table-striped invoice-table"
					data-table-key="output-invoice" data-export-name="{{ "List of output invoices"|t }}">
					<thead class="text-center">
						<tr>
							<th data-col-lock="1" data-col-sort="0" data-col-export="0" data-col-label="{{ "Select"|t }}">
								<input type="checkbox" id="select-invoice-all" class="form-check-input"/>
							</th>
							<th class="text-nowrap" data-col-lock="1" data-col-sort="0" data-col-index="1">{{ "Stt"|t }}</th>
							<th class="text-nowrap" data-col-export="0" data-col-sort="0">{{ "File"|t }}</th>
							<th class="text-nowrap">{{ "Invoice no"|t }}</th>
							<th class="text-nowrap">{{ "Invoice date"|t }}</th>
							<th class="text-nowrap">{{ "Tax authority code"|t }}</th>
							<th class="text-nowrap">{{ "Company"|t }}</th>
							<th class="text-nowrap">{{ "Pattern"|t }}</th>
							<th class="text-nowrap">{{ "Serial"|t }}</th>
							<th class="text-nowrap">{{ "Amount without vat"|t }}</th>
							<th class="text-nowrap">{{ "Discount amount"|t }}</th>
							<th class="text-nowrap">{{ "Vat amount"|t }}</th>
							<th class="text-nowrap">{{ "Total amount"|t }}</th>
							<th class="text-nowrap">{{ "Invoice status"|t }}</th>
							<th class="text-nowrap">{{ "Related invoices"|t }}</th>
							<th class="text-nowrap">{{ "Buyer name"|t }}</th>
							<th class="text-nowrap">{{ "Buyer address"|t }}</th>
							<th class="text-nowrap">{{ "Buyer taxcode"|t }}</th>
							<th class="text-nowrap">{{ "Accountant refno"|t }}</th>
							<th class="text-nowrap" data-col-lock="1" data-col-export="0" data-col-sort="0">{{ "Action"|t }}</th>
						</tr>
					</thead>
					<tbody>
						{% for item in data %}
							<tr>
								<td class="text-center">
									{% if item.invoice_status.value in [1, 2, 3] and item.invoice_export != 1 %}
										<input type="checkbox" name="select-invoice" value="{{ item.uuid }}" class="form-check-input select-invoice"/>
									{% endif %}
								</td>
								<td class="text-center" data-value="{{ loop.index }}">{{ loop.index }}</td>
								<td class="text-center">
									{% if item.invoice_pdf is not empty %}
										<a href="{{ item.invoice_pdf }}" target="_blank">
											<i class="bi bi-filetype-pdf fs-5"></i>
										</a>
									{% endif %}
									{% if item.invoice_xml_file is not empty %}
										<a href="{{ item.invoice_xml_file }}" target="_blank">
											<i class="bi bi-filetype-xml fs-5"></i>
										</a>
									{% endif %}
								</td>
								<td class="text-center">
									{% if item.invoice_issue == '1' %}
										<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}" class="d-inline-block m-0 text-success text-decoration-none fw-medium use-ajax" data-dialog-type="modal" data-dialog-options='{"width":"70%","title":""}'>
											{{ item.invoice_no }}
										</a>
									{% else %}
										<small class="px-2 py-1 text-white text-nowrap rounded-pill bg-danger">{{ "Not yet issued"|t }}</small>
									{% endif %}
								</td>
								<td class="text-center">
									{{ item.invoice_date| date("d/m/Y") }}
								</td>
								<td class="text-center">
									{{ item.invoice_mccqt }}
								</td>
								<td class="text-start">{{ item.invoice_company }}</td>
								<td class="text-center">{{ item.invoice_pattern }}</td>
								<td class="text-center">{{ item.invoice_serial }}</td>
								<td class="text-end" data-value="{{ item.invoice_amount_without_vat }}">{{ item.invoice_amount_without_vat|number_format(0, ",", ".") }}</td>
								<td class="text-end" data-value="{{ item.invoice_discount_amount }}">{{ item.invoice_discount_amount|number_format(0, ",", ".") }}</td>
								<td class="text-end" data-value="{{ item.invoice_vat_amount }}">{{ item.invoice_vat_amount|number_format(0, ",", ".") }}</td>
								<td class="text-end" data-value="{{ item.invoice_total_amount }}">{{ item.invoice_total_amount|number_format(0, ",", ".") }}</td>
								<td class="text-center">{{ item.invoice_status.label }}</td>
								<td class="text-center">{{ item.invoice_relateds }}</td>
								<td class="text-start">{{ item.invoice_buyer }}</td>
								<td class="text-start">{{ item.invoice_buyer_address }}</td>
								<td class="text-center">{{ item.invoice_buyer_taxcode }}</td>
								<td class="text-center">{{ item.invoice_refno }}</td>
								<td>
									<div class="dropdown">
										<button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
											<i class="bi bi-list"></i>
										</button>
										<ul class="dropdown-menu">
											<li>
												<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}" class="dropdown-item use-ajax" data-dialog-type="modal" data-dialog-options='{";width";:";70%";,";title";:";";}'>
													{{ "Detail"|t }}
												</a>
											</li>
											{% if item.invoice_status.value == 0 %}
												<li>
													<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}/edit?destination={{ filter.destination }}" class="btn-config-invoice dropdown-item">
														{{ "Edit invoice"|t }}
													</a>
												</li>
												<li>
													<a type="button" class="btn-config-invoice dropdown-item" data-bs-toggle="modal" data-bs-target="#configInvoiceModal"
														data-invoice-uuid="{{ item.uuid }}" data-company-id="{{ item.invoice_company_id }}" data-routing="{{ path("erp_e_invoice.e_invoice_preview") }}">
														{{ "Preview PDF"|t }}
													</a>
												</li>
												<li>
													<a type="button" class="btn-config-invoice dropdown-item" data-bs-toggle="modal" data-bs-target="#configInvoiceModal"
														data-invoice-uuid="{{ item.uuid }}" data-company-id="{{ item.invoice_company_id }}" data-routing="{{ path("erp_e_invoice.e_invoice_issue") }}">
														{{ "Issue invoice"|t }}
													</a>
												</li>
											{% else %}
												{%  if item.invoice_xml != '1' %}
													{% if item.invoice_issue == '0' %}
														<li>
															<a type="button" class="btn-config-invoice dropdown-item" data-bs-toggle="modal" data-bs-target="#configInvoiceModal"
																data-invoice-uuid="{{ item.uuid }}" data-company-id="{{ item.invoice_company_id }}" data-routing="{{ path("erp_e_invoice.e_invoice_preview") }}">
																{{ "Preview PDF"|t }}
															</a>
														</li>
													{% else %}
														{% if item.invoice_pdf is not empty %}
															<li>
																<a class="dropdown-item" href="{{ item.invoice_pdf }}" target="_blank">
																	{{ "View PDF"|t }}
																</a>
															</li>
														{% else %}
															<li>
																<a class="dropdown-item" href="{{ path("erp_e_invoice.e_invoice_pdf_invoice", {"uuid": item.uuid} , {"query" : {"destination" : filter.destination}}) }}">
																	{{ "Download PDF"|t }}
																</a>
															</li>
														{% endif %}
													{% endif %}
													{% if item.invoice_status.value == 1 %}
														<li>
															<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}/replace?destination={{ filter.destination }}" class="btn-config-invoice dropdown-item">
																{{ "Replace invoice"|t }}
															</a>
														</li>
													{% endif %}
													{% if item.invoice_status.value == 2 and item.invoice_issue == '0' %}
														<li>
															<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}/edit?destination={{ filter.destination }}" class="btn-config-invoice dropdown-item">
																{{ "Edit invoice"|t }}
															</a>
														</li>
														<li>
															<a type="button" class="btn-config-invoice dropdown-item" data-bs-toggle="modal" data-bs-target="#configInvoiceModal"
																data-invoice-uuid="{{ item.uuid }}" data-company-id="{{ item.invoice_company_id }}" data-routing="{{ path("erp_e_invoice.e_invoice_replate") }}">
																{{ "Issue replace invoice"|t }}
															</a>
														</li>
													{% endif %}
													{% if item.invoice_status.value == 2 and item.invoice_issue != '0' %}
														<li>
															<a type="button" class="btn-params-invoice dropdown-item" data-bs-toggle="modal"
																data-bs-target="#paramsInvoiceModal" data-invoice-uuid="{{ item.uuid }}">
																{{ "Status invoice"|t }}
															</a>
														</li>
													{% endif %}
												{% endif %}
											{% endif %}
											{%  if item.invoice_xml != '1' %}
												<li>
													<a href="{{ path('<front>') }}invoice-uuid/{{ item.uuid }}/duplicate?destination={{ filter.destination }}" class="btn-config-invoice dropdown-item">
														{{ "Duplicate invoice"|t }}
													</a>
												</li>
											{% endif %}
											{% if item.invoice_status.value in [1, 2, 3] and item.invoice_export != 1 %}
												<li>
													<a href="{{ path('<front>') }}accountant/invoice/{{ item.uuid }}?destination={{ filter.destination }}" class="dropdown-item">
														{{ "Create export"|t }}
													</a>
												</li>
											{% endif %}
										</ul>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<nav class="invoice-pagination d-flex justify-content-center mt-2" aria-label="{{ "Pagination"|t }}">
				<ul class="pagination pagination-sm mb-0 invoice-pages"></ul>
			</nav>
		</div>
	</div>
</div>

<!-- Modal -->
{{ include('@erp_e_invoice/templates/modal/modal-template.html.twig') }}
{{ include('@erp_e_invoice/templates/modal/modal-import.html.twig') }}
