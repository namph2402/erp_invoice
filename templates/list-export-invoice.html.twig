<div class="list-invoice d-flex flex-column h-100 min-w-0">
	{% include "@erp_e_invoice/warehouse-filter.html.twig" %}

	<div class="flex-grow-1 min-h-0 min-w-0 p-2 bg-white">
		<div class="d-flex flex-column h-100 text-center">
			<h4 class="text-uppercase fw-bold my-2" id="title-report">
				{{ "List of delivery notes"|t }}
			</h4>

			<div class="small text-muted mb-2">
				{{ "Report period"|t }}:
				{% if filter.date.start or filter.date.end %}
					{{ filter.date.start ? filter.date.start|date("d/m/Y") : "..." }}
					-
					{{ filter.date.end ? filter.date.end|date("d/m/Y") : "..." }}
				{% else %}
					{{ "Full date"|t }}
				{% endif %}
			</div>

			<div class="invoice-toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
				<select id="invoice-page-size-export" class="form-select form-select-sm invoice-page-size">
					{% for page_size in filter.option_page_size %}
						<option value="{{ page_size }}" {% if filter.page_size == page_size %} selected {% endif %}>{{ page_size }}</option>
					{% endfor %}
					<option value="0">{{ "All"|t }}</option>
				</select>
				<span class="small text-muted text-nowrap invoice-range"></span>
				<button type="button" class="btn btn-success btn-sm text-nowrap btn-export-excel ms-auto">
					<i class="bi bi-file-earmark-excel me-1"></i>{{ "Export Excel"|t }}
				</button>
			</div>

			{% if data is empty %}
				<p class="text-muted py-3">{{ "No delivery note in this period."|t }}</p>
			{% endif %}

			<div class="flex-grow-1 min-h-0 min-w-0 invoice-table-wrapper">
				<table class="table table-hover table-bordered table-striped invoice-table"
					data-table-key="export-warehouse"
					data-export-name="{{ "List of delivery notes"|t }}"
					data-export-title="{{ "List of delivery notes"|t }}{% if filter.export.warehouse %} - {{ filter.export.warehouse }}{% endif %}"
					data-export-period="{{ "Report period"|t }}: {{ filter.export.period }}"
					data-export-range="{{ filter.export.range }}">
					<thead class="text-center">
						<tr>
							<th class="text-nowrap" data-col-sort="0" data-col-index="1">{{ "Nº"|t }}</th>
							<th>{{ "Title"|t }}</th>
							<th class="text-nowrap">{{ "Date export"|t }}</th>
							<th class="w-15">{{ "Customer"|t }}</th>
							<th>{{ "Warehouse"|t }}</th>
							<th class="text-nowrap">{{ "Quantity"|t }}</th>
							<th class="text-nowrap">{{ "Total vat"|t }}</th>
							<th class="text-nowrap">{{ "Total amount"|t }}</th>
							<th>{{ "Invoice"|t }}</th>
						</tr>
					</thead>
					<tbody>
						{% for item in data %}
							<tr>
								<td class="text-center" data-value="{{ loop.index }}">{{ loop.index }}</td>
								<td class="text-start">
									<a href="{{ item.url }}" class="list-unstyled use-ajax"
										data-dialog-type="modal" data-dialog-options='{"width":"70%","title":""}'>
										{{ item.title }}
									</a>
									<small class="d-block text-muted">{{ "Lines"|t }}: {{ item.lines }}</small>
								</td>
								<td class="text-center">{{ item.date ? item.date|date("d/m/Y") }}</td>
								<td class="text-start">{{ item.contact }}</td>
								<td class="text-start">{{ item.warehouse }}</td>
								<td class="text-end" data-value="{{ item.quantity }}">{{ item.quantity|number_format(0, ",", ".") }}</td>
								<td class="text-end" data-value="{{ item.total_vat }}">{{ item.total_vat|number_format(0, ",", ".") }}</td>
								<td class="text-end" data-value="{{ item.total_amount }}">{{ item.total_amount|number_format(0, ",", ".") }}</td>
								<td class="text-start">
									{% if item.invoice_uuid %}
										<a href="{{ path('<front>') }}invoice-uuid/{{ item.invoice_uuid }}" class="dropdown-item use-ajax"
											data-dialog-type="modal" data-dialog-options='{"width":"70%","title":""}'>
											{{ item.invoice_title }}
										</a>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<nav class="invoice-pagination d-flex justify-content-center mt-2" aria-label="{{ "Pagination"|t }}">
				<ul class="pagination pagination-sm mb-0 invoice-pages"></ul>
			</nav>
		</div>
	</div>
</div>
