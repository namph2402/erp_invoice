<div class="list-invoice d-flex flex-column h-100">
	<div class="flex-grow-1 overflow-hidden p-2 bg-white">
		<div class="d-flex flex-column h-100 text-center">
			<div class="flex-grow-1 overflow-auto h-100">
				<table class="table table-hover table-bordered table-striped">
					<thead class="text-center">
						<tr>
							<th>{{ "Nº"|t }}</th>
							<th>{{ "Date export"|t }}</th>
							<th>{{ "Quantity"|t }}</th>
							<th>{{ "Price"|t }}</th>
							<th>{{ "Amount"|t }}</th>
							<th>{{ "Customer"|t }}</th>
							<th>{{ "Title export"|t }}</th>
							<th>{{ "Title invoice"|t }}</th>
						</tr>
					</thead>
					<tbody>
						{% for item in data %}
							<tr>
								<td class="text-center">{{ loop.index }}</td>
								<td class="text-center">{{ item.date ? item.date|date("d/m/Y") }}</td>
								<td class="text-end">{{ item.quantity|number_format(0, ",", ".") }}</td>
								<td class="text-end">{{ item.price|number_format(0, ",", ".") }}</td>
								<td class="text-end">{{ item.amount|number_format(0, ",", ".") }}</td>
								<td class="text-start">{{ item.contact }}</td>
								<td class="text-start">
									<a class="list-unstyled" href="{{ item.url }}" target="_blank">{{ item.title }}</a>
								</td>
								<td class="text-start">
									{% if item.invoice_uuid %}
										<a class="list-unstyled" href="{{ path('<front>') }}invoice-uuid/{{ item.invoice_uuid }}" target="_blank">{{ item.invoice_title }}</a>
									{% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="8" class="text-muted py-3">{{ "No delivery note in this period."|t }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
